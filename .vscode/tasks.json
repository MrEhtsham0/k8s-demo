{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Git hooks (core.hooksPath)",
      "type": "shell",
      "command": "./.githooks/install",
      "windows": {
        "command": "powershell -NoProfile -File .githooks/install.ps1"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
