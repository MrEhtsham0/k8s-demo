# COPY this file to k8s-secret.yml (gitignored) and fill real values.
#   cp k8s/k8s-secret.yml.example k8s/k8s-secret.yml
#
# Never commit k8s-secret.yml. Kubernetes Secrets are only base64-encoded,
# not encrypted — keeping them out of git is the first defense for local learning.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  labels:
    app: postgres
type: Opaque
stringData:
  POSTGRES_USER: change-me
  POSTGRES_PASSWORD: change-me
  POSTGRES_DB: appdb
  # Hostname "postgres" matches the Postgres Service name in k8s-postgres.yml
  DATABASE_URL: postgresql+asyncpg://change-me:change-me@postgres:5432/appdb
